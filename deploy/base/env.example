# deploy/base/env.example
#
# base/compose.yaml が参照する環境変数の一覧と説明（Design.md 4.3）。
# 値は compose.yaml に直接記述しているため、通常このファイルをコピーする必要はない。
# 環境ごとに変えたい場合のみ deploy/<env>/compose.yaml で上書きする。
#
# 秘密（パスワード・接続文字列）は環境変数に置かず、deploy/<env>/secrets/ の
# ファイルとして渡す。docker inspect や ps で見えないようにするため（DbDesign.md 3.2）。

# ── db（PostgreSQL 公式イメージの変数）──────────────────────────
POSTGRES_DB=pb                                    # データベース名
POSTGRES_USER=pb_owner                            # スキーマ所有者。DDL を実行するロール（DbDesign.md 3.4）
POSTGRES_PASSWORD_FILE=/run/secrets/db_password   # pb_owner のパスワード（ファイル経由）
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C --lc-ctype=C.UTF-8   # 並び順は C、文字の種類は C.UTF-8（DbDesign.md 3.1 / 4.5）
TZ=UTC
PGTZ=UTC

# ── app：第1層（起動前に要る。環境変数か *_FILE でしか渡せない）──────────
PB_BIND=0.0.0.0:8080                              # コンテナ内の待受。公開範囲は compose の ports で制御する
PB_DATABASE_URL_FILE=/run/secrets/app_database_url # pb_app での接続文字列（ファイル経由）
PB_CONFIG_FILE=                                   # 設定ファイル（YAML）の位置。任意（Design.md 10.3）

# ── app：第2層（実行中に画面から変えられる。**ここに書くと固定される**）──────
#
# **優先順は <KEY>_FILE ＞ PB_CONFIG_FILE の YAML ＞ 環境変数 ＞ app_setting ＞ 既定値**
# （Design.md 10.3）。したがって**下の4件を環境変数で与えると、画面から変更できなくなる。**
# 画面には「環境変数で固定されています」と出る。
#
# **既定値の正本は server/internal/config/registry.go である。** ここにも
# compose.yaml にも既定を書かない——書くと画面が読み取り専用になる。
#
#   log_format           json / text。標準出力へ書く（Design.md 10.1）
#   log_level            debug / info / warn / error。debug で /healthcheck のアクセスログも出る
#   health_show_version  GET /healthcheck にバージョンを含めるか（ApiDesign.md 2.11）
#   cookie_secure        pb_session / pb_csrf に Secure を付けるか（Design.md 6.2.1）
#
# 固定したい場合だけ、対応する環境変数（PB_LOG_FORMAT 等）を与える。

# ── secrets（deploy/<env>/secrets/ に実ファイルを置く。.gitignore 対象）────
#   db_password        pb_owner のパスワード
#   app_db_password    pb_app のパスワード。initdb/01_roles.sh がロール作成時に読む
#   app_database_url   pb_app での接続文字列。app_db_password と同じ値を埋め込む
