# deploy/stg/pb.env.example
#
# 正本: Design.md 4.4（stg の扱い）/ deploy/base/env.example（設定項目の一覧）
#
# **build.sh の出力に pb.env として同梱される設定である。** 出力を丸ごと任意の
# パスへ置いても動くよう、パスは出力ディレクトリからの相対で書く。
#
# make stg-init が本ファイルを deploy/stg/pb.env として複製する。
# 実体の pb.env は .gitignore の対象（端末ごとに変えてよい）。
#
# **秘密（パスワード・接続文字列）をここに書かない。** 接続文字列は
# PB_DATABASE_URL_FILE が指すファイルに置き、この設定ファイルにも
# 環境変数の値にも現れないようにする（DbDesign.md 3.2）。

# 待受。dev（127.0.0.1:8080）と分ける（Design.md 4.4）。
# **ブラウザでは http://localhost:8081 を開く**——Cookie はポートを区別しないため、
# 127.0.0.1 で開くと dev のログインセッションと上書きし合う（同 4.4）。
PB_BIND=127.0.0.1:8081

# pb_app での接続文字列を置いたファイル。**run.sh が自身の位置へ cd してから
# pb を起動する**ので、この相対パスは出力ディレクトリから解決される。
PB_DATABASE_URL_FILE=./secrets/app_database_url

# ログ（Design.md 10.1）。標準出力へ構造化 JSON を書く。
PB_LOG_FORMAT=json
PB_LOG_LEVEL=info

# どのビルドが動いているかを GET /healthcheck で確かめられるようにする
# （ApiDesign.md 2.11）。待受が 127.0.0.1 限定なので dev と同じ扱いでよい。
PB_HEALTH_SHOW_VERSION=true

# http で提供するため false。**true にすると Cookie が送られず、
# ログインが黙って失敗する**（Design.md 6.2.1）。
PB_COOKIE_SECURE=false
