# 配置先: .gitignore
# ─────────────────────────────────────────────
# 秘密情報（絶対にコミットしない）
# ─────────────────────────────────────────────
deploy/*/secrets/*
!deploy/*/secrets/*.example
!deploy/*/secrets/.gitkeep
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ─────────────────────────────────────────────
# ビルド成果物
# ─────────────────────────────────────────────
/bin/
/dist/
client/dist/
# webui/dist は embed の対象。実ビルド成果物は無視し、
# コンパイルを通すためのプレースホルダのみコミットする
server/internal/webui/dist/*
!server/internal/webui/dist/index.html

# ─────────────────────────────────────────────
# Go
# ─────────────────────────────────────────────
*.test
*.out
coverage.*
vendor/

# ─────────────────────────────────────────────
# Node / Vite
# ─────────────────────────────────────────────
node_modules/
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# ─────────────────────────────────────────────
# エディタ・OS
# ─────────────────────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# ─────────────────────────────────────────────
# Claude Code（ローカル設定は共有しない）
# ─────────────────────────────────────────────
.claude/settings.local.json
